# The only HTTP service reachable by Cloudflare Tunnel. Do not publish a host
# port in production; this listener is private to Docker networks.
events {}

http {
  server_tokens off;

  upstream web_upstream { server web:3000; }
  upstream api_upstream { server api:8000; }

  server {
    listen 8080;
    server_name _;
    client_max_body_size 10m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    location /api/ {
      proxy_pass http://api_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Request-ID $request_id;
      proxy_read_timeout 3600s;
      proxy_buffering off;
    }

    location / {
      proxy_pass http://web_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Request-ID $request_id;
    }

    # No Hermes API, Dashboard, Gateway, ZITADEL administration, PostgreSQL,
    # Docker, or management routes are defined here.
  }
}
