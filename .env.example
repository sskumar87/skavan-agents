# Server-side only. Never expose this value to browser code.
HERMES_API_SERVER_KEY=
HERMES_PERSONAL_API_SERVER_KEY=
HERMES_WORK_API_SERVER_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Product database (Laptop 1 private data node)
DATABASE_URL=postgresql+asyncpg://skavan_app:change-me@laptop1.internal:5432/skavan
# Deployment-only credential used by the one-off Alembic migration job.
SKAVAN_MIGRATION_DATABASE_URL=postgresql+asyncpg://skavan_migrator:change-me@laptop1.internal:5432/skavan
# Optional dedicated name for Alembic commands. Keep it out of source control.
SKAVAN_DATABASE_URL=

# OIDC BFF configuration. All values are server-side only.
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_SESSION_MAX_AGE=31536000
ZITADEL_ISSUER_URL=https://auth.example.com
ZITADEL_CLIENT_ID=
ZITADEL_PROJECT_ID=
ZITADEL_ORGANIZATION_ID=
# PAT for a dedicated least-privilege service account that can manage only
# Skavan project role assignments. Never expose this to the browser.
ZITADEL_ROLE_PROVISIONER_TOKEN=
# Optional private JWKS route for deployments where public ingress blocks backend requests.
OIDC_JWKS_URL=

# Laptop 2 local identity bootstrap. Production uses auth.<domain> over HTTPS.
ZITADEL_DATABASE_POSTGRES_DSN=postgresql://zitadel:change-me@192.168.1.49:5432/zitadel?sslmode=disable
ZITADEL_MASTERKEY_FILE=C:/SKAV_PLATFORM/secrets/skavan-phase1/zitadel-masterkey
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=
LOGIN_CLIENT_PAT_EXPIRATION=2027-08-21T00:00:00Z

# Laptop 2 service topology. Store production values outside Git.
APP_ORIGIN=https://app.example.com
ZITADEL_EXTERNAL_PORT=443
ZITADEL_EXTERNAL_SECURE=true
ZITADEL_EXTERNAL_SCHEME=https
CLOUDFLARED_CONFIG_DIR=/opt/skavan/secrets/cloudflared
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.3@sha256:e39ee8da81ad5e05d77f38d2f51c60ca51bf2a8450ac3abab50c17fdb91d91bf
NGINX_IMAGE=nginx:stable-alpine@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46
NODE_IMAGE=node:24.19.0-alpine3.24@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43
PYTHON_IMAGE=python:3.13.14-slim-bookworm@sha256:67a1e1f215ccda113cfc024e8639049257e88f273898f595b61476d128d387e8

# Hermes is reached only by the API on the private service network. Set the
# verified API endpoint for the selected upstream deployment.
HERMES_API_BASE_URL=http://hermes:8642
HERMES_MODEL=hermes-agent
HERMES_DATA_DIR=C:/SKAV_PLATFORM/secrets/skavan-phase1/hermes
# Read-only project workspace exposed to Hermes as /workspace. The external
# secrets subdirectory is masked by a separate empty Docker volume.
SKAV_PLATFORM_DIR=C:/SKAV_PLATFORM

# Required only when enabling the optional Compose profiles; use pinned,
# verified upstream images and their documented deployment configuration.
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.17.1@sha256:3ac6910685d48f32481f01f45e3e6215efe5a9df2c069591b481e9a101712db5
ZITADEL_LOGIN_IMAGE=ghcr.io/zitadel/zitadel-login:v4.17.1@sha256:8035df2409afb35a3999482ee98e453261715f98d47e4b62e948e4a1ddf4345f
TRAEFIK_IMAGE=traefik:v3.7.7@sha256:1cb3845d7a05e1473c9086351426597e911db49db382b6e4769f9b0744962ac8
ZITADEL_DOMAIN=auth.example.com
ZITADEL_MASTERKEY_FILE=/opt/skavan/secrets/zitadel/masterkey
ZITADEL_DATABASE_POSTGRES_DSN=postgresql://zitadel:change-me@laptop1.internal:5432/zitadel?sslmode=require
LOGIN_CLIENT_PAT_EXPIRATION=2027-08-21T00:00:00Z
TRAEFIK_TRUSTED_IPS=172.16.0.0/12
HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.18@sha256:22e37bb4ed1b0f50cb6bd991dca7ecacd6c9f29df9b4a20fc989d32bc763ccf6
