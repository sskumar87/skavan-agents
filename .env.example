# Server-side only. Never expose this value to browser code.
HERMES_API_SERVER_KEY=

# Product database (Laptop 1 private data node)
DATABASE_URL=postgresql+asyncpg://skavan_app:change-me@laptop1.internal:5432/skavan
# Deployment-only credential used by the one-off Alembic migration job.
SKAVAN_MIGRATION_DATABASE_URL=postgresql+asyncpg://skavan_migrator:change-me@laptop1.internal:5432/skavan
# Optional dedicated name for Alembic commands. Keep it out of source control.
SKAVAN_DATABASE_URL=

# OIDC configuration
OIDC_ISSUER_URL=https://auth.example.internal
OIDC_CLIENT_ID=skavan-web

# Laptop 2 service topology. Store production values outside Git.
APP_ORIGIN=https://app.example.com
CLOUDFLARED_IMAGE=
NGINX_IMAGE=
NODE_IMAGE=
PYTHON_IMAGE=

# Hermes is reached only by the API on the private service network. Set the
# verified API endpoint for the selected upstream deployment.
HERMES_API_BASE_URL=http://hermes:8642

# Required only when enabling the optional Compose profiles; use pinned,
# verified upstream images and their documented deployment configuration.
ZITADEL_IMAGE=
ZITADEL_EXTERNALDOMAIN=
ZITADEL_EXTERNALPORT=443
ZITADEL_DATABASE_POSTGRES_HOST=laptop1.internal
ZITADEL_DATABASE_POSTGRES_PORT=5432
ZITADEL_DATABASE_POSTGRES_DATABASE=zitadel
ZITADEL_DATABASE_POSTGRES_USER_USERNAME=zitadel
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=
HERMES_IMAGE=
